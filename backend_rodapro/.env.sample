# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=sis257_rodapro
DB_PASSWORD=123456
DB_NAME=rodapro

# JWT
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Usuario administrador inicial (se crea solo si no existe ningún usuario)
ADMIN_NOMBRE_COMPLETO=Administrador RODAPRO
ADMIN_USUARIO=admin
ADMIN_PASSWORD=Admin123*

# Datos de la tienda que ve el cliente en la landing y el catálogo público
TIENDA_NOMBRE=RODAPRO
TIENDA_DIRECCION=Av. Circunvalación, Sucre
# Teléfono fijo (opcional). Vacío = no se muestra
TIENDA_TELEFONO=
# WhatsApp solo con dígitos y código de país (Bolivia = 591). Vacío = oculta el botón de WhatsApp
TIENDA_WHATSAPP=59175776595
# Cada tramo separado por "|" (se muestra uno por línea)
TIENDA_HORARIO=Lunes a viernes: 9:00 a 18:00|Sábado: 9:00 a 13:00|Domingo: cerrado
# Botón "Ver cómo llegar" (enlace de Google Maps)
TIENDA_MAPA_URL=https://maps.app.goo.gl/LUBxDzK94AoAC7PV9
# Mapa visible en la landing. Opciones (se usa la primera que tenga valor):
#  1) TIENDA_MAPA_EMBED: en Google Maps > Compartir > "Insertar un mapa" > copie solo el valor de src="..."
#  2) TIENDA_LATITUD y TIENDA_LONGITUD: coordenadas exactas del local (ej. -19.0431 y -65.2592)
#  3) Si ambos están vacíos, el mapa se busca por TIENDA_DIRECCION
TIENDA_MAPA_EMBED=
TIENDA_LATITUD=
TIENDA_LONGITUD=